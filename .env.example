AI_CORE_CLIENT_ID=
AI_CORE_CLIENT_SECRET=
AI_CORE_AUTH_URL=
AI_API_URL=
RESOURCE_GROUP=default
AI_API_VERSION=2024-12-01-preview

# Famiglia di modelli: openai (default) | google | anthropic
LLM_PROVIDER=openai
# Un deployment per famiglia; DEPLOYMENT_ID vale ancora per openai
DEPLOYMENT_ID_OPENAI=
DEPLOYMENT_ID_GOOGLE=
GOOGLE_MODEL=
DEPLOYMENT_ID_ANTHROPIC=

# Nome del modello mostrato nella pagina (opzionale, altrimenti un nome generico)
MODEL_LABEL_OPENAI=
MODEL_LABEL_GOOGLE=
MODEL_LABEL_ANTHROPIC=

# Massimo di token della risposta (default 64000; Gemini max 65536, OpenAI max 128000)
LLM_MAX_OUTPUT_TOKENS=
