<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core"
  controllerName="itas.ecbrk.Main" height="100%">
  <Page title="Rendiconti provvigionali" enableScrolling="false" class="sapUiNoContentPadding">
    <headerContent>
      <Text text="{= 'Modello: ' + ${/modelLabel}}" visible="{= !!${/modelLabel}}" class="sapUiSmallMarginEnd"/>
      <Text text="{/fileName}" class="sapUiSmallMarginEnd"/>
      <Button text="Carica documento" icon="sap-icon://upload" type="Emphasized"
        enabled="{= !${/busy}}" press=".onPickFile"/>
    </headerContent>
    <content>
      <l:Splitter height="100%">
        <core:HTML content="&lt;iframe id='pdfPreview' style='width:100%;height:100%;border:0'&gt;&lt;/iframe&gt;">
          <core:layoutData><l:SplitterLayoutData size="50%"/></core:layoutData>
        </core:HTML>
        <ScrollContainer height="100%" vertical="true">
          <layoutData><l:SplitterLayoutData size="auto"/></layoutData>
          <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
            <HBox alignItems="Center" wrap="Wrap">
              <Title text="Posizioni estratto conto ({/count})" class="sapUiSmallMarginEnd"/>
              <ObjectStatus inverted="true" visible="{= !!${/confidenza}}"
                text="{path: '/confidenza', formatter: '.formatConfidenceText'}"
                state="{path: '/confidenza', formatter: '.formatConfidenceState'}"
                tooltip="{path: '/confidenza', formatter: '.formatConfidenceTooltip'}"/>
            </HBox>
            <Text id="tempoElaborazione" text="{path: '/tempoMs', formatter: '.formatDuration'}"
              visible="{= ${/tempoMs} !== null}"
              tooltip="Tempo di elaborazione del file: dalla ricezione sul server alla risposta (lettura del PDF, modello IA e salvataggio)"/>
          </HBox>
          <HBox wrap="Wrap" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" visible="{= ${/count} > 0}">
            <VBox class="sapUiMediumMarginEnd">
              <Label text="Totale premi"/>
              <ObjectNumber number="{path: '/totalePremi', formatter: '.formatAmount'}" emphasized="true"/>
            </VBox>
            <VBox class="sapUiMediumMarginEnd">
              <Label text="Totale provvigioni"/>
              <ObjectNumber number="{path: '/totaleProvvigioni', formatter: '.formatAmount'}" emphasized="true"/>
            </VBox>
            <VBox visible="{= ${/ritenuta} !== null}">
              <Label text="Ritenuta d'acconto"/>
              <ObjectNumber number="{path: '/ritenuta', formatter: '.formatAmount'}" emphasized="true"/>
            </VBox>
          </HBox>
          <Table items="{/rows}" busy="{/busy}" busyIndicatorDelay="0" noDataText="{/emptyText}">
            <columns>
              <Column><Text text="Data effetto"/></Column>
              <Column><Text text="Contraente"/></Column>
              <Column><Text text="Numero polizza"/></Column>
              <Column hAlign="End"><Text text="Premi"/></Column>
              <Column hAlign="End"><Text text="Provvigioni"/></Column>
              <Column><Text text="Data incasso"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <Text text="{path: 'dataEffetto', formatter: '.formatDate'}"/>
                <Text text="{contraente}"/>
                <Text text="{numeroPolizza}"/>
                <Text text="{path: 'premi', formatter: '.formatAmount'}"/>
                <Text text="{path: 'provvigioni', formatter: '.formatAmount'}"/>
                <Text text="{path: 'dataIncasso', formatter: '.formatDate'}"/>
              </ColumnListItem>
            </items>
          </Table>
        </ScrollContainer>
      </l:Splitter>
    </content>
  </Page>
</mvc:View>
